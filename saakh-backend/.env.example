PORT=5000
JWT_SECRET=your_jwt_secret_key_here
DATABASE_PATH=./saakh.db
NODE_ENV=development

# SMS OTP Provider Configuration
# Supported providers: 2factor | msg91 | fast2sms | mock
SMS_PROVIDER=2factor

# 2Factor.in Gateway (Recommended for Indian Mobile Numbers)
# Register at: https://2factor.in
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_OTP_TEMPLATE=OTP_VERIFICATION

# MSG91 Gateway (Enterprise DLT Gateway)
# Register at: https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here

# Fast2SMS Gateway (Alternative)
# Register at: https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OTP Security, Rate Limiting & Cooldown Settings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
